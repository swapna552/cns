import java.io.*;
import java.util.*;

public class HillCipher {
    static float[][] decrypt = new float[3][1];
    static float[][] a = new float[3][3];  // Key matrix
    static float[][] b = new float[3][3];  // Inverse matrix
    static float[][] mes = new float[3][1];  // Message matrix
    static float[][] res = new float[3][1];  // Result matrix
    static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) throws IOException {
        getkeymes();  // Get key and message input
        
        // Encrypting the message
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 1; j++) {
                res[i][j] = 0;  // Reset res[i][j]
                for (int k = 0; k < 3; k++) {
                    res[i][j] += a[i][k] * mes[k][j];
                }
            }
        }

        System.out.print("\nEncrypted string is: ");
        for (int i = 0; i < 3; i++) {
            System.out.print((char) (res[i][0] % 26 + 97));
            mes[i][0] = res[i][0]; // Store the encrypted result in mes for decryption
        }

        inverse();  // Get inverse of the key matrix
        
        // Decrypting the message
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 1; j++) {
                decrypt[i][j] = 0;  // Reset decrypt[i][j]
                for (int k = 0; k < 3; k++) {
                    decrypt[i][j] += b[i][k] * res[k][j];
                }
            }
        }

        System.out.print("\nDecrypted string is: ");
        for (int i = 0; i < 3; i++) {
            System.out.print((char) (decrypt[i][0] % 26 + 97));
        }
        System.out.print("\n");
    }

    // Method to get the key matrix and message
    public static void getkeymes() throws IOException {
        System.out.println("Enter 3x3 matrix for key (It should be inversible): ");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                a[i][j] = sc.nextFloat();
            }
        }

        System.out.print("\nEnter a 3-letter string: ");
        String msg = br.readLine();
        for (int i = 0; i < 3; i++) {
            mes[i][0] = msg.charAt(i) - 97; // Convert letter to corresponding integer (a=0, b=1, c=2, etc.)
        }
    }

    // Method to find the inverse of the key matrix (mod 26)
    public static void inverse() {
        float p, q;
        float[][] c = new float[3][3];
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                c[i][j] = a[i][j]; // Copy the key matrix
                b[i][j] = (i == j) ? 1 : 0; // Initialize b as identity matrix
            }
        }

        // Perform Gaussian elimination
        for (int k = 0; k < 3; k++) {
            if (c[k][k] == 0) {
                System.out.println("Matrix is singular, cannot find inverse.");
                return;
            }

            for (int i = 0; i < 3; i++) {
                if (i != k) {
                    p = c[i][k] / c[k][k];
                    for (int j = 0; j < 3; j++) {
                        c[i][j] -= p * c[k][j];
                        b[i][j] -= p * b[k][j];
                    }
                }
            }
        }

        // Normalize the inverse matrix
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                b[i][j] /= c[i][i];
                b[i][j] = b[i][j] % 26; // Ensure it stays in the mod 26 range
            }
        }

        System.out.println("\nInverse Matrix is: ");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print((int) b[i][j] + " ");
            }
            System.out.println();
        }
    }
}
