import java.util.*;
import javax.crypto.*;
import javax.crypto.spec.DESedeKeySpec;
import java.util.Base64;

class DES {
    public static void main(String[] args) throws Exception {

        Scanner sc = new Scanner(System.in);

        // Secret key
        String keyText = "ThisIsSecretEncryptionKey";
        DESedeKeySpec spec = new DESedeKeySpec(keyText.getBytes());
        SecretKeyFactory factory = SecretKeyFactory.getInstance("DESede");
        SecretKey key = factory.generateSecret(spec);

        // Create cipher
        Cipher cipher = Cipher.getInstance("DESede");

        // Input
        System.out.print("Enter the string: ");
        String text = sc.nextLine();

        // Encryption
        cipher.init(Cipher.ENCRYPT_MODE, key);
        byte[] encrypted = cipher.doFinal(text.getBytes());
        String enc = Base64.getEncoder().encodeToString(encrypted);

        // Decryption
        cipher.init(Cipher.DECRYPT_MODE, key);
        byte[] decrypted = cipher.doFinal(Base64.getDecoder().decode(enc));

        // Output
        System.out.println("\nString To Encrypt: " + text);
        System.out.println("Encrypted Value : " + enc);
        System.out.println("Decrypted Value : " + new String(decrypted));
    }
}
