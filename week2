#include <stdio.h>
#include <string.h>

int main()
{
    char str[] = "Hello World";
    int i, len;

    len = strlen(str);

    printf("AND with 127: ");
    for(i = 0; i < len; i++)
    {
        printf("%c", str[i] & 127);
    }

    printf("\nXOR with 127: ");
    for(i = 0; i < len; i++)
    {
        printf("%c", str[i] ^ 127);
    }

    printf("\n");
    return 0;
}
